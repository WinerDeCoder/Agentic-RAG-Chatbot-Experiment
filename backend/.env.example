# Main backend environment template.
# Copy the values you need into backend/.env.

OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_tavily_api_key
GOOGLE_API_KEY=your_google_api_key
# GEMINI_API_KEY=your_google_api_key_alternative

QDRANT_URL=https://your-qdrant-host:6333
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=
QDRANT_COLLECTION_PREFIX=gcp2_1536_page_level
QDRANT_COLLECTION_VERSION=v1
QDRANT_COLLECTION_NAME=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_EMBEDDING_DIMENSION=1536

TAVILY_DEFAULT_TOPIC=general
TAVILY_DEFAULT_SEARCH_DEPTH=basic
TAVILY_DEFAULT_MAX_RESULTS=5
TAVILY_DEFAULT_INCLUDE_ANSWER=true
TAVILY_DEFAULT_INCLUDE_RAW_CONTENT=false
TAVILY_DEFAULT_INCLUDE_IMAGES=false
TAVILY_TIMEOUT_SECONDS=30

AGENTIC_LOG_LEVEL=INFO
AGENTIC_LOG_FILE=logs/agentic.log
AGENTIC_PLAN_EXECUTE_CONFIG=config/plan_execute.yaml
AGENTIC_PLANNER_MODEL=gpt-5.4-mini
AGENTIC_EXECUTOR_MODEL=gpt-5.4-mini
AGENTIC_REPLANNER_MODEL=gpt-5.4-mini
AGENTIC_REASONING_EFFORT=low
AGENTIC_MAX_REPLANS=3
AGENTIC_EXECUTOR_MAX_TURNS=3

CHAT_HISTORY_DB_HOST=your-db-host
CHAT_HISTORY_DB_PORT=5432
CHAT_HISTORY_DB_NAME=your_chat_database
CHAT_HISTORY_DB_USER=your_db_user
CHAT_HISTORY_DB_PASSWORD=your_db_password
CHAT_HISTORY_DB_SCHEMA=your_chat_schema
CHAT_HISTORY_DEFAULT_USER_ID=sample-user
CHAT_HISTORY_DEFAULT_USER_NAME=Sample User

MLFLOW_TRACING_ENABLED=true
MLFLOW_TRACKING_URI=http://your-mlflow-host:5000
MLFLOW_EXPERIMENT_NAME=agentic_rag_experiment
MLFLOW_LANGCHAIN_RUN_TRACER_INLINE=true
MLFLOW_LANGCHAIN_AUTOLOG_ENABLED=true